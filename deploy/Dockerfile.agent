FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY deploy/requirements/agent.txt ./requirements.txt
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY src ./src

# Sin root: el acceso al socket de Docker se da con group_add en docker-compose.yml.
RUN groupadd --gid 10002 sms-agent && \
    useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin sms-agent

EXPOSE 8001
USER 10002:10002
CMD ["uvicorn", "--factory", "server_monitor.agent.main:build_app_from_env", "--host", "0.0.0.0", "--port", "8001"]
