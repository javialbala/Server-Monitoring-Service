FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# 1) Dependencias: versiones exactas y hashes exportados de uv.lock (ADR-013).
#    --require-hashes hace que pip rechace cualquier paquete cuyo contenido no coincida.
#    Se copian antes que el código para que Docker reutilice esta capa si solo cambia src/.
COPY deploy/requirements/controlplane.txt ./requirements.txt
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# 2) Código: no se instala como paquete (evitaría descargar la herramienta de build sin
#    versión fija); basta con que esté en PYTHONPATH.
COPY src ./src

# Usuario sin privilegios (UID/GID fijos para poder razonar sobre permisos).
RUN groupadd --gid 10001 minipaas && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin minipaas

EXPOSE 8000
USER 10001:10001
CMD ["uvicorn", "--factory", "minipaas.controlplane.main:build_app_from_env", "--host", "0.0.0.0", "--port", "8000"]
