FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# Versiones exactas y hashes de uv.lock; antes que el código para reutilizar la capa.
COPY deploy/requirements/panel.txt ./requirements.txt
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY src ./src

RUN groupadd --gid 10001 sms-panel && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sms-panel

EXPOSE 8000
USER 10001:10001
CMD ["uvicorn", "--factory", "server_monitor.panel.main:build_app_from_env", "--host", "0.0.0.0", "--port", "8000"]
